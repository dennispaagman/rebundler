# frozen_string_literal: true

source "https://rubygems.org"

gem "debug" # Debugging functionality for Ruby
gem "minitest", "~> 5.26" # minitest provides a complete suite of testing facilities supporting TDD, BDD, mocking, and benchmarking
gem "minitest-difftastic" # Minitest Plugin to use difftastic for failed assertions
gem "rake", "~> 13.0" # Rake is a Make-like program implemented in Ruby
gem "rebundler", path: ".", require: false # Rebundler makes your Gemfile look good.
gem "rubocop", "~> 1.21" # Automatic Ruby code style checking tool.
gem "rubocop-minitest" # Automatic Minitest code style checking tool.
gem "rubocop-rake" # A RuboCop plugin for Rake
gem "ruby-lsp" # An opinionated language server for Ruby
gem "zeitwerk" # Efficient and thread-safe constant autoloader
